FROM python:3.11-slim

WORKDIR /app

COPY pyproject.toml ./
COPY src/ ./src/

RUN pip install --no-cache-dir .

COPY models/artifacts/baseline.onnx /app/models/artifacts/baseline.onnx

ENV PRODML_ONNX_MODEL_PATH=/app/models/artifacts/baseline.onnx

EXPOSE 8000

CMD ["uvicorn", "prodml.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
